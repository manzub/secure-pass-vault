<h2>Edit Password</h2>

<form id="editPasswordForm">
    <div>
        <label for="editPasswordName">Name</label>
        <input type="text" id="editPasswordName" required>
    </div>

    <div>
        <label for="editPasswordUsername">Username / Email</label>
        <input type="text" id="editPasswordUsername" autocomplete="off">
    </div>

    <div>
        <label for="editPasswordValue">Password</label>
        <input type="password" id="editPasswordValue" autocomplete="off" spellcheck="false" required>
        <button type="button" id="editGeneratePasswordButton">
            Generate Password
        </button>

        <div id="editPasswordGeneratorOptions">
            <label for="editGeneratorLength">Password Length</label>
            <input type="number" id="editGeneratorLength" min="8" max="128" value="20">

            <label>
                <input type="checkbox" id="editGeneratorLowercase" checked>
                Lowercase
            </label>

            <label>
                <input type="checkbox" id="editGeneratorUppercase" checked>
                Uppercase
            </label>

            <label>
                <input type="checkbox" id="editGeneratorNumbers" checked>
                Numbers
            </label>

            <label>
                <input type="checkbox" id="editGeneratorSymbols" checked>
                Symbols
            </label>
        </div>
    </div>

    <div>
        <label for="editPasswordWebsite">Website</label>
        <input type="url" id="editPasswordWebsite">
    </div>

    <div>
        <label for="editPasswordNotes">Notes</label>
        <textarea id="editPasswordNotes"></textarea>
    </div>

    <button type="submit" id="editPasswordSaveButton">
        Save Changes
    </button>

    <button type="button" id="editPasswordCancelButton">
        Cancel
    </button>

    <p id="editPasswordMessage" role="status"></p>
</form>