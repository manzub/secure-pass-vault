<section id="vaultDashboard">
    <h1>My Vault</h1>

    <p id="vaultStatus"></p>

    <button id="addEntryButton" data-view="createNote" type="button">
        Add Entry
    </button>

    <button id="lockVaultButton" type="button">
        Lock Vault
    </button>

    <button id="logoutButton" type="button">Log Out</button>
    <br />
    <div id="vaultEntries">
        <p>Your vault entries will appear here.</p>
    </div>
</section>