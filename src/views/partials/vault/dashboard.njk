<section id="vaultDashboard">
    <h1>My Vault</h1>

    <p id="vaultStatus"></p>

    <button id="addEntryButton" data-view="createNote" type="button">
        Add Entry
    </button>

    <button type="button" data-view="createPassword">
        Add Password
    </button>

    <button id="lockVaultButton" type="button">
        Lock Vault
    </button>

    <button id="logoutButton" type="button">Log Out</button>
    <br />
    <div id="searchActions">
        <div id="searchFormInputss">
            <input type="search" id="vaultSearchInput" placeholder="Search passwords and notes..." autocomplete="off"
                aria-label="Search vault entries">
        </div>

        <div id="vaultFilters" role="group" aria-label="Filter vault entries">
            <button type="button" data-filter="all" aria-pressed="true">
                All
            </button>

            <button type="button" data-filter="password">
                Passwords
            </button>

            <button type="button" data-filter="note">
                Notes
            </button>
        </div>
    </div>
    <hr>
    <div id="sortActions">
        <label for="vaultSort">Sort by</label>

        <select id="vaultSort">
            <option value="name-asc">Name (A–Z)</option>
            <option value="name-desc">Name (Z–A)</option>
            <option value="created-desc">Newest first</option>
            <option value="created-asc">Oldest first</option>
            <option value="updated-desc">Recently updated</option>
            <option value="updated-asc">Least recently updated</option>
        </select>
    </div>
    <br>
    <hr>

    <section id="vaultSecurityOverview" aria-labelledby="vaultSecurityHeading">
        <h2 id="vaultSecurityHeading">Vault Security</h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
            <div>
                <h3>Total Passwords</h3>
                <p id="securityTotalPasswords">0</p>
            </div>

            <button type="button" id="filterReusedPasswords">
                <h3>Reused Passwords</h3>
                <p id="securityReusedPasswords">0</p>
            </button>

            <button type="button" id="filterWeakPasswords">
                <h3>Weak Passwords</h3>
                <p id="securityWeakPasswords">0</p>
            </button>

            <div>
                <h3>Strong Passwords</h3>
                <p id="securityStrongPasswords">0</p>
            </div>
        </div>
    </section>
    <hr>
    <div id="securityFilterStatus" class="hidden items-center justify-between gap-3 mb-4">

        <p id="securityFilterLabel" class="text-sm font-medium"></p>

        <button type="button" id="clearSecurityFilter" class="text-sm text-blue-600 hover:underline">
            Clear filter
        </button>
    </div>
    <hr>
    <div id="vaultEntries">
        <p>Your vault entries will appear here.</p>
    </div>
</section>