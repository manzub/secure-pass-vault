<h1>{{ title }}</h1>
<section id="noteDetail">
    <button type="button" data-view="dashboard">
        Back to Vault
    </button>

    <h1 id="detailNoteTitle"></h1>

    <pre id="detailNoteContent" style="white-space: pre-wrap; overflow-wrap: anywhere;"></pre>

    <p id="detailNoteMessage" role="status"></p>

    <button type="button" id="detailEditButton">
        Edit Note
    </button>

    <button type="button" id="detailDeleteButton" disabled>
        Delete Note
    </button>
</section>