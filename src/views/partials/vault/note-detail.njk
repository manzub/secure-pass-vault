<h1>{{ title }}</h1>
<div id="noteDetail">
    <h3 id="detailNoteTitle"></h3>
    <div id="content">
        <pre style="white-space: pre-wrap;overflow-wrap: anywhere" id="detailNoteContent"></pre>
    </div>
    <p id="detailNoteMessage" role="status" aria-live="polite"></p>
    <br>
    <a href="#" id="detailEditButton">Edit Note</a>
    <button type="button" id="detailDeleteButton" disabled>Delete Note</button>
    <button type="button" data-view="dashboard">Go Back</button>
</div>