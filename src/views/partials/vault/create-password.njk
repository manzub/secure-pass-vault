<h2>Add Password</h2>

<form id="createPasswordForm">
    <div>
        <label for="passwordName">Name</label>
        <input type="text" id="passwordName" name="name" required>
    </div>

    <div>
        <label for="passwordUsername">Username or Email</label>
        <input type="text" id="passwordUsername" name="username" autocomplete="off">
    </div>

    <div>
        <label for="passwordValue">Password</label>
        <input type="password" id="passwordValue" name="password" autocomplete="new-password" required>
    </div>

    <div>
        <label for="passwordWebsite">Website</label>
        <input type="url" id="passwordWebsite" name="website" placeholder="https://example.com">
    </div>

    <div>
        <label for="passwordNotes">Notes</label>
        <textarea id="passwordNotes" name="notes"></textarea>
    </div>

    <button type="submit" id="createPasswordSaveButton">
        Save Password
    </button>
    <br>
    <button type="button" data-view="dashboard">
        Back to Vault
    </button>

    <p id="createPasswordMessage" role="status"></p>
</form>