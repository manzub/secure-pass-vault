<h2>Add Password</h2>

<form id="createPasswordForm">
    <div>
        <label for="passwordName">Name</label>
        <input type="text" id="passwordName" name="name" required>
    </div>

    <div>
        <label for="passwordUsername">Username or Email</label>
        <input type="text" id="passwordUsername" name="username" autocomplete="off">
    </div>

    <div>
        <label for="passwordValue">Password</label>
        <input type="password" id="passwordValue" name="password" autocomplete="new-password" required>
        <button type="button" id="generatePasswordButton">
            Generate Password
        </button>
        <div id="passwordGeneratorOptions">
            <div>
                <label for="generatorLength">Password Length</label>
                <input type="number" id="generatorLength" min="8" max="128" value="20">
            </div>

            <div>
                <label>
                    <input type="checkbox" id="generatorLowercase" checked>
                    Lowercase (a-z)
                </label>
            </div>

            <div>
                <label>
                    <input type="checkbox" id="generatorUppercase" checked>
                    Uppercase (A-Z)
                </label>
            </div>

            <div>
                <label>
                    <input type="checkbox" id="generatorNumbers" checked>
                    Numbers (0-9)
                </label>
            </div>

            <div>
                <label>
                    <input type="checkbox" id="generatorSymbols" checked>
                    Symbols (!@#$...)
                </label>
            </div>
        </div>
        {# password strength estimate #}
        <div id="passwordStrengthContainer" class="mt-2">
            <div class="flex gap-1">
                <div class="password-strength-segment h-1.5 flex-1 rounded bg-gray-200"></div>
                <div class="password-strength-segment h-1.5 flex-1 rounded bg-gray-200"></div>
                <div class="password-strength-segment h-1.5 flex-1 rounded bg-gray-200"></div>
                <div class="password-strength-segment h-1.5 flex-1 rounded bg-gray-200"></div>
            </div>

            <p id="passwordStrengthLabel" class="mt-2 text-sm text-gray-500">
                Enter a password to check its strength.
            </p>
        </div>
    </div>

    <div>
        <label for="passwordWebsite">Website</label>
        <input type="url" id="passwordWebsite" name="website" placeholder="https://example.com">
    </div>

    <div>
        <label for="passwordNotes">Notes</label>
        <textarea id="passwordNotes" name="notes"></textarea>
    </div>

    <button type="submit" id="createPasswordSaveButton">
        Save Password
    </button>
    <br>
    <button type="button" data-view="dashboard">
        Back to Vault
    </button>

    <p id="createPasswordMessage" role="status"></p>
</form>