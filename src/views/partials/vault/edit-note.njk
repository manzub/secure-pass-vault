<section id="editNote">
    <h2>Edit Note</h2>

    <form id="editNoteForm">
        <label for="editNoteTitle">Title</label>
        <input id="editNoteTitle" name="title" type="text" required>
        <br>

        <label for="editNoteContent">Content</label>
        <textarea id="editNoteContent" name="content" required></textarea>
        <br>

        <button type="submit" id="editNoteSaveButton">
            Save Changes
        </button>
    </form>

    <p id="editNoteMessage" role="status"></p>

    <button type="button" data-view="dashboard">
        Back to Vault
    </button>
</section>