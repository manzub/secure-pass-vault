<h2 id="detailPasswordName"></h2>

<div>
    <label>Username / Email</label>
    <p id="detailPasswordUsername"></p>

    <button type="button" id="detailUsernameCopy">
        Copy Username
    </button>
</div>

<div>
    <label>Password</label>
    <input type="password" id="detailPasswordValue" readonly autocomplete="off" spellcheck="false">

    <button type="button" id="detailPasswordToggle">
        Show
    </button>

    <button type="button" id="detailPasswordCopy">
        Copy Password
    </button>
</div>

<div>
    <label>Website</label>
    <p id="detailPasswordWebsite"></p>
</div>

<div>
    <label>Notes</label>
    <p id="detailPasswordNotes"></p>
</div>

<section id="detailPasswordSecurity" class="hidden mt-4" aria-labelledby="detailPasswordSecurityHeading">

    <h3 id="detailPasswordSecurityHeading">
        Password Security
    </h3>

    <div class="flex items-center justify-between">
        <span>Password strength</span>
        <span id="detailPasswordStrengthLabel"></span>
    </div>

    <div id="detailPasswordStrengthBars" class="grid grid-cols-4 gap-1 mt-2">

        <div class="h-2 rounded bg-gray-200"></div>
        <div class="h-2 rounded bg-gray-200"></div>
        <div class="h-2 rounded bg-gray-200"></div>
        <div class="h-2 rounded bg-gray-200"></div>
    </div>

    <p id="detailPasswordSecurityWarning" class="hidden text-amber-600 text-sm mt-3">
    </p>

    <div id="detailPasswordRecommendations" class="hidden mt-3">

        <h4>Recommendations</h4>

        <ul id="detailPasswordSuggestions" class="list-disc pl-5 text-sm">
        </ul>
    </div>
</section>

<div>
    <button type="button" id="detailPasswordEditButton">
        Edit
    </button>

    <button type="button" id="detailPasswordDeleteButton">
        Delete
    </button>

    <button type="button" data-view="dashboard">
        Back to Vault
    </button>
</div>

<p id="detailPasswordMessage" role="status"></p>