{% extends "layouts/base.njk" %}

{% block page_title %}{{ title }}{% endblock %}

{% block page_content %}
<div id="vaultShell">

    <div id="vaultUnlockView" hidden>
        {% include "partials/vault/unlock.njk" %}
    </div>

    <div id="vaultDashboardView" hidden>
        {% include "partials/vault/dashboard.njk" %}
    </div>

    <div id="vaultCreateNoteView" hidden>
        {% include "partials/vault/create-note.njk" %}
    </div>

    <div id="vaultNoteDetailView" hidden>
        {% include "partials/vault/note-detail.njk" %}
    </div>

    <div id="vaultEditNoteView" hidden>
        {% include "partials/vault/edit-note.njk" %}
    </div>

    {# password #}
    <div id="createPasswordView" hidden>
        {% include "partials/vault/create-password.njk" %}
    </div>

    <div id="passwordDetailView" hidden>
        {% include "partials/vault/password-detail.njk" %}
    </div>

    <div id="editPasswordView" hidden>
        {% include "partials/vault/edit-password.njk" %}
    </div>
</div>
{% endblock %}

{% block additional_scripts %}
{# Third-party dependencies #}
<script src="/public/vendor/zxcvbn.js" defer></script>

{# Core #}
<script src="/public/js/core/vault-worker-client.js" defer></script>
<script src="/public/js/core/auth-fetch.js" defer></script>
<script src="/public/js/core/vault-entry-client.js" defer></script>
<script src="/public/js/core/vault-shell.js" defer></script>
<script src="/public/js/core/vault-sync.js" defer></script>
<script src="/public/js/core/vault-auto-lock.js" defer></script>

{# Utilities #}
<script src="/public/js/utils/password-generator.js" defer></script>
<script src="/public/js/utils/password-strength.js" defer></script>
<script src="/public/js/utils/password-reuse.js" defer></script>
<script src="/public/js/utils/vault-security.js" defer></script>

{# Authentication views #}
<script src="/public/js/views/unlock.js" defer></script>

{# Password views #}
<script src="/public/js/views/create-password.js" defer></script>
<script src="/public/js/views/password-detail.js" defer></script>
<script src="/public/js/views/edit-password.js" defer></script>

{# Note views #}
<script src="/public/js/views/create-note.js" defer></script>
<script src="/public/js/views/note-detail.js" defer></script>
<script src="/public/js/views/edit-note.js" defer></script>

{# Dashboard #}
<script src="/public/js/views/dashboard.js" defer></script>
{% endblock %}