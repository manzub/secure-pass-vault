{% extends "layouts/base.njk" %}

{% block page_title %}{{ title }}{% endblock %}

{% block page_content %}
<main>
    <h1>{{ title }}</h1>
    <form id="editNoteForm">
        <label for="noteTitle">Title</label>
        <input type="text" name="noteTitle" required id="noteTitle">
        <br>

        <label for="noteContent">Note</label>
        <textarea name="noteContent" id="noteContent"></textarea>
        <br>

        <button type="submit" id="saveNoteButton">Save Note</button>
        <br>
        <a href="#" id="cancelEditLink">Cancel Edit</a>
        <a href="/vault">Go back to Vault</a>

        <p id="noteMessage" role="status" aria-live="polite"></p>
    </form>
</main>
{% endblock %}

{% block additional_scripts %}
<script src="/public/js/vault-worker-client.js"></script>
<script src="/public/js/vault-entry-client.js"></script>
<script src="/public/js/vault-edit-note.js"></script>
{% endblock %}